# Sanity-project ID. Publiek zichtbaar in elke API-aanvraag die de browser
# maakt, dus met het NEXT_PUBLIC_-voorvoegsel. Geen geheim.
# Te vinden in studio/sanity.config.ts, of op manage.sanity.io.
NEXT_PUBLIC_SANITY_PROJECT_ID=5o909qb6

# Sanity-dataset. Ook publiek, zelfde reden als hierboven.
# Te vinden in studio/sanity.config.ts.
NEXT_PUBLIC_SANITY_DATASET=production

# Geen token hier: de Next-app leest alleen publieke, gepubliceerde
# content en heeft dus geen API-token nodig. Het seed-script in
# studio/scripts/seed.ts gebruikt wel een token, maar dat staat in
# studio/.env.local — een apart, eveneens gitignored bestand.
